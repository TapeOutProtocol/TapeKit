{
  "name": "tapekit",
  "private": true,
  "description": "Tapekit: the open-source browser kernel for the TapeOut protocol. Websites stored byte-for-byte on BNB Chain, X Layer and Base, read and verified directly by the client.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "cd kernel && node --test test/unit.test.mjs",
    "test:mainnet": "cd kernel && node --test test/mainnet.test.mjs",
    "test:e2e": "cd sw-gateway && node test/e2e.mjs",
    "build:extension": "node build-extension.mjs",
    "dev:viewer": "node dev-server.mjs",
    "dev:gateway": "node sw-gateway/dev-server.mjs",
    "test:types": "tsc -p kernel/test/types/tsconfig.json",
    "build:gateway": "node sw-gateway/build.mjs",
    "block": "node sw-gateway/block.mjs"
  },
  "devDependencies": {
    "ethers": "^6.13.0",
    "typescript": "^5.6.0",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=18"
  }
}
